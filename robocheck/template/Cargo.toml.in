# Generated by robocheck from robocheck/template/Cargo.toml.in. Do not edit.
[package]
name = "{{CRATE}}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
robocode = { path = "{{ROBOCODE_PATH}}" }
vstd = { version = "=0.0.0-2026-11-01-0251", optional = true }
sha2 = "0.10"

[features]
verus = ["robocode/verus", "dep:vstd"]

[[bin]]
name = "{{BIN}}"
path = "src/bin/battle.rs"

[package.metadata.verus]
verify = true

[lints.rust]
unused_variables = "allow"
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(verus_only)', 'cfg(verus_keep_ghost)'] }

[workspace]
